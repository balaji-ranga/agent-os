# Dependencies
node_modules/

# Environment and secrets (never commit)
.env
.env.local
.env.*.local
*.env

# Data and DB
backend/data/
*.db
*.db-journal
*.db-shm
*.db-wal

# Desktop package: cached portable Node (downloaded at package-build time)
backend/data/cache/
**/cache/desktop-node-win-x64/

# Logs and build
*.log
npm-debug.log*
dist/
build/
.vite/
docs-site/.docusaurus/
deploy/static/flolah-home/docs/
deploy/static/flolah-home/blog/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Optional: OpenClaw local paths (if you symlink or copy)
# .openclaw/

# Deploy secrets and generated TLS
deploy/.env
deploy/.env.bak*
deploy/*.env.bak*
deploy/nginx/certs/*.pem

deploy/.admin-password.txt
.env.bak*
*.bak-merge
*.bak

# Local dumps, probes, and copies of live snapshots — never commit
tmp/
backend/tmp/
# Local one-off probes/patches (often talk to VPS or mint sessions) — never commit
backend/scripts/_*
scripts/_*
tmp-oc-*
tmp-cf-*
tmp-cheapflights-*
t.js
