        "data": {
          "label": "Brain / vision LLM - inspect room",
          "taskConfig": {
            "mode": "describe",
            "resultSchemaJson": "{\"type\":\"object\",\"properties\":{\"tv_state\":{\"type\":\"string\",\"enum\":[\"on\",\"off\",\"unknown\"]},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":800}},\"required\":[\"tv_state\",\"confidence\",\"reason\"]}",
            "prompt": "Inspect only the attached room image. Is the television screen visibly displaying a picture and therefore on? A black unlit screen means off. If the screen is hidden, absent or ambiguous report unknown with low confidence. Do not infer state from the filename or metadata. Return tv_state, confidence from 0 to 1, and a concise visible reason.",
            "nodeTimeoutMs": 90000,
            "timeoutAction": "fail"
          },
          "inputBindings": [
            {
              "id": "image",
              "mode": "dynamic",
              "sourceNodeId": "capture",
              "sourceOutputKey": "frame"
            }
          ]
        }
