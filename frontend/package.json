    "test:timezone": "node ./scripts/test-display-timezone.mjs",
    "test:chat": "node ./scripts/test-chat-tables.mjs && node ./scripts/test-chat-goal-references.mjs",
    "test:efficiency-controls": "node ./scripts/test-efficiency-controls.mjs",
    "test:design-system": "node ./scripts/test-design-system.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.1",
    "iso-3166": "^4.4.0",
    "parse5": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
