{
  "name": "agent-os-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/test-knowledge-search-modes.mjs",
    "test:home-team-activity": "node ./scripts/test-home-team-activity.mjs",
    "test:action-approval": "node ./scripts/test-action-approval-state.mjs",
    "dev": "vite",
    "build": "node ./scripts/check-utf8.mjs && node ./scripts/test-display-timezone.mjs && node ./scripts/test-virtual-room-placement.mjs && node ./scripts/test-design-system.mjs && node ./scripts/test-ibkr-bridge-status.mjs && vite build --configLoader runner",
