# Agent OS — production Compose environment
# Copy to .env and fill in secrets before deploy.
# Keys are injected at container runtime — not baked into images.
# Init writes OPENCLAW_GATEWAY_TOKEN + TOOLS_API_KEY into openclaw.json (gateway + content-tools plugin).

# ---- Public URL ----
AGENT_OS_PUBLIC_URL=https://agent-os.example.com
# Production example: https://flolah.cloud  (use this host for API/E2E — not a parked marketing domain)
VITE_API_URL=/api

# Platform API access + error logging for backend: off | error | info
#   off   — no platform API logs
#   error — 5xx access lines + unhandled errors only
#   info  — every API request/response + errors (default)
PLATFORM_LOG_LEVEL=info

# Optional: A2A secured access-token TTL (seconds). Default 3600.
# A2A_ACCESS_TOKEN_TTL_SEC=3600
# Optional A2A invoke timing (milliseconds):
# A2A_SYNC_TIMEOUT_MS=120000          # sync invoke hold (default 2 min)
# A2A_ASYNC_WATCH_TIMEOUT_MS=86400000 # background async task watch (default 24h)
# A2A_CALLBACK_TIMEOUT_MS=15000       # outbound callback POST timeout

# Optional summary-cache full-rebuild cadence (days; default 7 each):
# LEARNINGS_FULL_REBUILD_DAYS=7
# ORDER_LEARNINGS_FULL_REBUILD_DAYS=7
# BRAIN_HISTORY_FULL_REBUILD_DAYS=7

# ---- Gateway auth (written to openclaw.json at init) ----
OPENCLAW_GATEWAY_TOKEN=change-me-generate-a-long-random-token

# ---- Content tools: OpenClaw plugin ↔ backend auth (required for COO/MCP/kanban tools) ----
# Must match plugins.entries['agent-os-content-tools'].config.apiKey written at init.
# Generate: node ../scripts/ensure-tools-api-key.js --env-file .env --skip-openclaw
TOOLS_API_KEY=change-me-generate-a-long-random-secret

# Backend tool self-dispatch (POST /api/tools/invoke → tool endpoint).
# Must be loopback inside the backend container — public HTTPS (self-signed / hairpin) fails as "fetch failed".
TOOLS_BASE_URL=http://127.0.0.1:3001

# Dedicated OpenClaw agent id for backend CDP browser invokes (browse_* / job portal).
# Must match configure-openclaw-docker.js — profile=coding + alsoAllow browser; chat agents deny native browser.
# BROWSER_TASK_CDP_AGENT_ID=browser-cdp

# ---- Internal service auth (workflow runner, tools proxy, cron-callback) ----
# Required in production — must be stable across container restarts (not ephemeral).
# Auto-generated by ./scripts/up.sh if empty. Or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_OS_INTERNAL_TOKEN=

# ---- Platform admin ----
AGENT_OS_ADMIN_EMAIL=admin@agent-os.local
AGENT_OS_ADMIN_PASSWORD=change-me-admin-password

# ---- OpenClaw gateway + backend: OpenAI-compatible primary ----
# Production default: DeepSeek V4 Flash. Swap BASE_URL / MODEL / KEY for OpenAI or another host.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Per-CEO API Keys vault (Management → API Keys). Required when users set an encryption phrase.
# Generate: openssl rand -hex 32
USER_API_KEYS_KEK=

# Aliases (optional — used if OPENAI_API_KEY / OPENAI_BASE_URL not set)
# OPENAI_PRIMARY_API_KEY=
OPENAI_PRIMARY_BASE_URL=https://api.deepseek.com/v1
OPENAI_PRIMARY_MODEL=deepseek-v4-flash

# OpenClaw default agent model slug (written to openclaw.json at init)
OPENCLAW_MODEL_PRIMARY=openai/deepseek-v4-flash

# Optional comma-separated OpenClaw model fallbacks (e.g. openai/gpt-4o-mini).
# Leave empty unless you intentionally want failover (do not point at ollama/* for production COO).
OPENCLAW_MODEL_FALLBACKS=

# Ollama as OpenClaw silent fallback (default off — tool calling is unreliable on small local models)
# Set to 1 only for experiments; configure-openclaw-docker.js clears fallbacks when unset/0
OPENCLAW_ENABLE_OLLAMA_FALLBACK=0

# ---- Anthropic (OpenClaw gateway — e.g. anthropic/claude-opus-4-6) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ---- Secondary OpenAI-compatible endpoint (optional; Admin "Use secondary") ----
# OPENAI_SECONDARY_BASE_URL=https://api.openai.com/v1
# OPENAI_SECONDARY_API_KEY=
# OPENAI_SECONDARY_MODEL=gpt-4o-mini
# Or another OpenAI-compatible host:
# OPENAI_SECONDARY_BASE_URL=https://api.deepseek.com/v1
# OPENAI_SECONDARY_API_KEY=
# OPENAI_SECONDARY_MODEL=deepseek-chat

# ---- CEO Profile BYOK chat model fallbacks (when llm_model not yet set) ----
# Profile UI asks CEOs to pick provider + model; OpenClaw sync uses that choice.
# Internal endpoint map: openai → api.openai.com, openrouter → openrouter.ai, etc.
# These env vars are soft fallbacks only (never inherit OPENAI_PRIMARY_MODEL=deepseek-* for OpenAI BYOK).
# OPENAI_BYOK_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Catalog: GET /api/auth/llm-catalog  (backend/src/config/llm-provider-registry.js)

# ---- Ollama (OpenClaw optional-ollama profile + BYOK Free) ----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=ollama-local
# Default pull / BYOK Free model (compose + backend)
OLLAMA_MODEL=llama3.2
# Context window for Ollama provider config (code default 32768; avoid 128k on small VPS RAM)
OLLAMA_CONTEXT_WINDOW=32768
# Alias used when wiring OpenClaw silent ollama fallback (only if ENABLE_OLLAMA_FALLBACK=1)
OPENCLAW_OLLAMA_FALLBACK_MODEL=llama3.2
# Optional: longer gateway timeout for slow local models (ms)
# OPENCLAW_OLLAMA_CHAT_TIMEOUT_MS=300000

# ---- Brave Search (agent tool + optional MCP profile) ----
# Agent content tool brave_web_search: Platform default Profile uses BRAVE_API_KEY;
# any other Profile LLM uses vault BRAVE_SEARCH_BYOK only (no platform fall-back).
# Brave Search MCP (profile optional-brave-mcp) remains BYOK via workflow headers —
# MCP container does NOT use BRAVE_API_KEY.
# Get a key: https://api-dashboard.search.brave.com/app/keys
# Start MCP: docker compose --profile optional-brave-mcp up -d --build brave-search-mcp
# Seed MCP: docker compose exec backend node scripts/seed-brave-search-mcp.js
BRAVE_API_KEY=
# BRAVE_MCP_URL=http://brave-search-mcp:8080/mcp
# Tool: brave_web_search (agent content tool + MCP wrapper).

# ---- OpenRouter (backend dev/scripts; Brain nodes use per-node keys in workflow editor) ----
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_SITE_TITLE=Agent OS

# ---- DeepSeek via local Ollama (no cloud API key) ----
# Requires: docker compose --profile optional-ollama up -d ollama
# Preferred model: deepseek-v3 (needs large GPU/RAM host).
# Small VPS auto-fallback: deepseek-r1:8b (ensure-deepseek-env.sh)
# DEEPSEEK_BASE_URL=http://ollama:11434/v1
# DEEPSEEK_MODEL=deepseek-v3
# DEEPSEEK_FALLBACK_MODEL=deepseek-r1:8b

# ---- Backend LLM overrides ----
# OPENAI_COO_MODEL=gpt-4o-mini
# OPENAI_INTENT_MODEL=
# TOOLS_SUMMARIZE_MODEL=

# ---- Content tools: image (OpenAI-compatible / GPT-image) ----
# Primary reuses OPENAI_PRIMARY_* / OPENAI_API_KEY above.
TOOLS_IMAGE_MODEL=gpt-image-1
TOOLS_IMAGE_SIZE=1024x1024
TOOLS_IMAGE_QUALITY=medium
TOOLS_IMAGE_STYLE=natural
TOOLS_IMAGE_MAX_PROMPT_CHARS=1000
# TOOLS_IMAGE_SECONDARY_MODEL=gpt-image-1-mini

# ---- Content tools: analyze_image (vision / OCR) ----
# Tool name: analyze_image. Platform default uses the same effective platform LLM as chat
# (Admin primary/secondary switch). BYOK Profiles use vault Platform_BYOK + Profile primary.
# Optional ops override (rare):
# TOOLS_VISION_MODEL=
# TOOLS_VISION_BASE_URL=
# TOOLS_VISION_API_KEY=
# TOOLS_VISION_MAX_TOKENS=1200
# TOOLS_VISION_MAX_MB=15

# ---- Content tools: Replicate video ----
REPLICATE_API_TOKEN=

# ElevenLabs (workflow ElevenLabs node TTS/STT). Avatar templates default vault key name "elevenlabs-key".
# AVATAR_MODEL_MAX_MB=80
ELEVENLABS_API_KEY=

# Free local STT/TTS — Compose profile optional-voice (started by ensure-voice-env.sh on deploy).
# Used by Agent Chat mic, workflow speech_* nodes, and COO content tools speech_tts / speech_stt.
# SKIP_VOICE=1 on deploy to skip containers. Defaults written by ensure-voice-env.sh if missing:
SPEECH_STT_URL=http://whisper:8000
SPEECH_TTS_URL=http://piper:5500
WHISPER_MODEL=Systran/faster-whisper-tiny.en
PIPER_VOICE=en_US-lessac-medium
# WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cpu
# Generated media (/api/media/openclaw/...) requires login by default.
# WhatsApp attaches via MEDIA:/abs/path on the shared openclaw volume — do not enable public signed URLs unless required.
# MEDIA_PUBLIC_SIGNED=1
# MEDIA_SIGNING_SECRET=

# Hunyuan3D optional GPU service (profile optional-hunyuan3d)
# HUNYUAN3D_URL=http://hunyuan3d:7860
# HUNYUAN3D_IMAGE=tencent/hunyuan3d:2.1
# HUNYUAN3D_TIMEOUT_MS=900000
REPLICATE_PRIMARY_BASE_URL=https://api.replicate.com/v1
# TOOLS_VIDEO_MODEL_VERSION=owner/model:version_id
# TOOLS_VIDEO_MAX_PROMPT_CHARS=500
# REPLICATE_SECONDARY_API_TOKEN=
# TOOLS_VIDEO_SECONDARY_MODEL_VERSION=

# ---- Job Applicant / browser timeouts (ms) ----
OPENCLAW_DISCOVERY_TIMEOUT_MS=900000
# Recommended when agents use browse_task_status wait_ms (up to 90000).
OPENCLAW_FETCH_TIMEOUT_MS=360000

# ---- Scheduled jobs (crons) — platform-level timers, per-user effect ----
# Every value has a built-in default; all keys are OPTIONAL and shown commented for reference.
# One timer runs per backend process; each tick loops over enabled CEOs / their own rows, so
# per-user settings (standup scheduled_at, workflow schedule_cron, data_retention_days) still apply.
# Full reference: knowledgebase/platform-help/19-scheduled-jobs-and-crons.md
# deploy/scripts/ensure-cron-env.sh appends this same block to deploy/.env on every deploy.
#
# STANDUP_SCHEDULE_CRON=* * * * *          # dispatcher: runs each user standup at its own scheduled_at
# STANDUP_CRON_SCHEDULE=                   # legacy auto-collect standup for every CEO (empty = disabled)
# DELEGATION_CRON_SCHEDULE=* * * * *       # process pending COO -> agent delegation tasks, per CEO
# DELEGATION_STATUS_ONLY_MAX_RETRIES=1      # auto-requeue when agent only posts "marked completed" (0–3)
# DELEGATION_GATEWAY_MAX_RETRIES=8         # leave delegation pending on OpenClaw unreachable (cap)
# STATUS_ONLY_REQUEUE_STARTUP_DELAY_MS=60000  # wait after boot before stuck status-only requeue
# AGENT_WORKFLOW_SCHEDULER_CRON=* * * * *  # master tick: runs user workflows whose schedule_cron is due
# JOB_PIPELINE_CRON_SCHEDULE=0 * * * *     # Job Applicant pipeline tick across active job profiles
# COO_STATUS_CHECKER_CRON=0 9 * * *        # daily CEO status report -> standup chat + HTML email
# DATA_RETENTION_CRON=15 3 * * *           # daily purge: chats/standup msgs/workflow runs + aged Content Explorer media (hard delete)
# KANBAN_ORPHAN_WATCHER_CRON=*/5 * * * *   # re-pend stuck processing + reinitiate orphan specialty Kanban cards
# KANBAN_ORPHAN_MAX_RETRIES=2              # cap automatic reinitiates per card (default 2)
# DELEGATION_SPECIALTY_PROCESSING_TIMEOUT_MS=600000  # specialty "processing" older than this → re-pend (default 10m)

# ---- OpenClaw channel media caps (configure-openclaw-docker.js) ----
# OPENCLAW_MEDIA_MAX_MB=128

# ---- Custom workflow scripts (Python/JS sandbox in backend container) ----
# CUSTOM_SCRIPT_MAX_BYTES=131072
# CUSTOM_SCRIPT_TIMEOUT_MS=60000
# CUSTOM_SCRIPT_PYTHON=python3
# CUSTOM_SCRIPT_NODE=node
# LLM security review at registration (uses OPENAI_* / Ollama above — same as backend LLM)
# CUSTOM_SCRIPT_LLM_REVIEW=1
# CUSTOM_SCRIPT_LLM_REVIEW_REQUIRED=1
# CUSTOM_SCRIPT_LLM_REVIEW_MAX_TOKENS=768

# ---- Workflow email + MFA + email_send content tool ----
# Used by: workflow Send Email node, email_send tool (incl. ICS calendar invites), MFA email OTP
# notify_ceo (in-app CEO push / NotificationBell) needs no SMTP — granted at backend boot
# Sender domain must be verified with your SMTP provider.
# WORKFLOW_SMTP_HOST=smtp.example.com
# WORKFLOW_SMTP_PORT=587
# WORKFLOW_SMTP_SECURE=0
# WORKFLOW_SMTP_USER=
# WORKFLOW_SMTP_PASS=
# WORKFLOW_SMTP_FROM=agent-os@example.com
# WORKFLOW_TEST_EMAIL_TO=you@example.com
# MFA_MODE=TOTP
# AGENT_OS_REQUIRE_MFA=1
# AGENT_OS_DISABLE_MFA=1

# ---- Market data (FMP) — monthly trading screener / regime / history ----
# MARKET_DATA_API_KEY=
# MARKET_DATA_PROVIDER=fmp
# MARKET_DATA_BASE_URL=https://financialmodelingprep.com/stable
# MARKET_DATA_SCREENER_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META
# Optional cache TTLs (seconds) — see knowledgebase/IBKR-MONTHLY-MAKER-TOOLS.md
# MARKET_DATA_CACHE_SCREENER_TTL_SEC_PAPER=21600
# MARKET_DATA_CACHE_SCREENER_TTL_SEC_LIVE=43200
# MARKET_DATA_CACHE_FUNDAMENTALS_TTL_SEC_PAPER=604800
# MARKET_DATA_CACHE_FUNDAMENTALS_TTL_SEC_LIVE=259200
# MARKET_DATA_CACHE_TODAY_BAR_TTL_SEC_PAPER=3600
# MARKET_DATA_CACHE_TODAY_BAR_TTL_SEC_LIVE=900
# MONTHLY_DRAWDOWN_STOP_PCT=4
# IBKR_IS_PAPER=true

# ---- Email inbound webhooks (SendGrid/Mailgun → public HTTPS) ----
# Providers POST to: ${AGENT_OS_PUBLIC_URL}/api/integrations/email-inbound/:definitionId
# EMAIL_INBOUND_WEBHOOK_SECRET=

# ---- OpenConnector (connectors façade + optional MCP) ----
# Real OpenConnector runtime (profile optional-openconnector)
# Runtime API (backend façade): OPENCONNECTOR_URL=http://openconnector:3000
# Public browser origin for OAuth callbacks + admin-gated console (nginx /openconnector/ → backend BFF).
# OPENCONNECTOR_PUBLIC_ORIGIN=https://agent-os.example.com/openconnector
# OOMOL_CONNECT_ORIGIN=https://agent-os.example.com/openconnector
# OPENCONNECTOR_URL=http://openconnector:3000
# OPENCONNECTOR_ADMIN_TOKEN=
# OPENCONNECTOR_ENCRYPTION_KEY=
# OPENCONNECTOR_BOOTSTRAP_RUNTIME_TOKEN=
# MCP discovery (Brain + MCP Integrations): OPENCONNECTOR_MCP_URL=http://openconnector:3000/mcp
# Mock profile optional-openconnector-mock: OPENCONNECTOR_URL=http://openconnector-mcp-mock:3105
# After stack is up: docker compose exec backend node scripts/seed-openconnector-mcp.js
# OPENCONNECTOR_MCP_URL=http://openconnector:3000/mcp
# OPENCONNECTOR_MCP_ID=mcp-openconnector
# OPENCONNECTOR_MCP_BEARER=
# OPENCONNECTOR_MCP_TRANSPORT=streamable_http
# OPENCONNECTOR_MOCK_TOKEN=

# ---- OpenSearch document RAG (internal Docker network only) ----
# Meta + search indices per user; platform indices for help/README.
# Never publish ports 9200/5601. Admin Dashboards: /opensearch/ (admin cookie BFF).
# Admin UI: /admin/documents-rag. Fresh host: bash scripts/ensure-opensearch-env.sh .env
# Kernel (once): sudo sysctl -w vm.max_map_count=262144  (+ persist in /etc/sysctl.conf)
OPENSEARCH_ENABLED=1
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_EMBEDDING_MODEL=text-embedding-3-small
OPENSEARCH_EMBEDDING_DIMS=1536
# Set 0 when primary LLM host has no /embeddings (e.g. DeepSeek) — BM25 still works.
# Set 1 for hybrid BM25+kNN, then Reindex all after recreate backend.
OPENSEARCH_EMBEDDINGS_ENABLED=0

# ---- CEO Onboarding Helper (OpenClaw tools; seeded at backend startup) ----
# Tools: onboarding_save_proposal, onboarding_apply_proposal (owner-scoped).
# UI: /onboarding selective Review. Docs + E2E prompts: knowledgebase/platform-help/27-onboarding-helper.md
# Script: backend/scripts/e2e-onboarding-wf-prompts.mjs  (BASE_URL=$AGENT_OS_PUBLIC_URL)
# Re-seed grants: docker exec … node scripts/seed-onboarding-helper-agent.js

# ---- Docker tool onboarding (Admin → Tools Onboarding) ----
# Mount socket via compose overlay: docker-compose.docker-tools.yml
# Fail-closed: empty DOCKER_TOOLS_REGISTRY_ALLOW refuses all pulls.
DOCKER_TOOLS_ENABLED=0
DOCKER_TOOLS_SOCKET=/var/run/docker.sock
DOCKER_TOOLS_SOCKET_HOST=/var/run/docker.sock
DOCKER_TOOLS_NETWORK=
# Comma-separated registry path prefixes (examples):
# DOCKER_TOOLS_REGISTRY_ALLOW=docker.io/library,docker.io/ealen,ghcr.io/myorg
DOCKER_TOOLS_REGISTRY_ALLOW=
DOCKER_TOOLS_REGISTRY_DENY=
DOCKER_TOOLS_MAX_MEMORY_MB=512
DOCKER_TOOLS_MAX_CPUS=1
DOCKER_TOOLS_STEPUP_TTL_MS=300000
# Restart OpenClaw after deploying a new Docker tool so the plugin registers it (set 0 to skip)
DOCKER_TOOLS_RESTART_OPENCLAW=1
DOCKER_GID=0

# ---- Docker disk hygiene (vps-deploy-latest.sh → docker-disk-hygiene.sh) ----
# After compose build, prune BuildKit cache older than UNTIL (keeps recent layers for faster rebuilds).
# SKIP_DOCKER_PRUNE=1 to skip. DOCKER_BUILDER_PRUNE_ALL=1 for a full unused-cache wipe.
# SKIP_DOCKER_PRUNE=0
# DOCKER_BUILDER_PRUNE_UNTIL=72h
# DOCKER_BUILDER_PRUNE_ALL=0
# SKIP_DANGLING_IMAGE_PRUNE=0

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# Smoke: docker compose exec -T backend node scripts/test-opensearch-rag-smoke.js

# ---- Filesystem workflow nodes + inbound / Content Explorer paths ----
# Compose default also mounts OpenClaw tenant + media roots (see docker-compose.yml).
# Content Explorer (`/content-explorer`) lists/deletes CEO uploaded + generated media under these roots.
# Retention (`DATA_RETENTION_CRON`) hard-deletes aged inbound + media/generated/<ceo>/ by mtime.
# Prefer compose default: /data/workflow-fs:/root/.openclaw/tenants:/root/.openclaw/media
WORKFLOW_FS_ROOTS=/data/workflow-fs

# ---- Workflow autonomous certify (Maker / Checker authoring loop) ----
# OpenClaw Workflow Builder face: agent_workflow_certify_start / _status / _resume.
# Deterministic Checker ALWAYS runs. LLM Checker is optional soft grading on top.
#
# WORKFLOW_CERTIFY_USE_LLM_CHECKER — 0/unset = OFF (recommended default; faster, no
#   hallucinated fail-flips). Set to 1 to enable LLM soft Checker (uses secondary
#   model unless WORKFLOW_CERTIFY_CHECKER_MODEL is set). Hard criteria still come
#   from the deterministic Checker.
# WORKFLOW_CERTIFY_USE_LLM_CHECKER=0
#
# WORKFLOW_CERTIFY_MAX_ATTEMPTS — outer Maker/Checker loops (default 5, hard cap 10)
# WORKFLOW_CERTIFY_MAX_ATTEMPTS=5
# WORKFLOW_CERTIFY_MAX_WALL_MS=300000
# WORKFLOW_CERTIFY_TEST_TIMEOUT_MS=45000
#
# Optional model overrides (else platform primary = Maker, secondary = LLM Checker):
# WORKFLOW_CERTIFY_MAKER_MODEL=
# WORKFLOW_CERTIFY_CHECKER_MODEL=
#
# Monthly Positive Return certify (Phase 4) — recommended BYOK models:
# WORKFLOW_CERTIFY_MAKER_MODEL=claude-opus-4-20250514
# WORKFLOW_CERTIFY_CHECKER_MODEL=deepseek-v4-flash
# Helper: node backend/scripts/certify-monthly-trading-workflows.js --dry-run
# Paper E2E (no live Opus/Gateway): node backend/scripts/test-monthly-trading-paper-e2e.js

# ---- Published ports ----
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# ---- Optional profiles ----
MCP_AUTO_EMIT_MS=5000
# WORKFLOW_HOOK_URL=https://agent-os.example.com/api/agent-workflows/hooks/<definitionId>
# WORKFLOW_HOOK_SECRET=
NOVNC_PORT=6080
# Container clock (cron schedules, log timestamps).
TZ=Asia/Singapore
# Timezone used to render dates for users (Kanban cards, task chat, reports).
# Defaults to TZ when unset; set it only if display should differ from the container clock.
# PLATFORM_TIMEZONE=Asia/Singapore
ENABLE_VNC=0

# OpenClaw session visibility (init → openclaw.json)
# OPENCLAW_SESSION_VISIBILITY=agent
