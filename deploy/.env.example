# OPENAI_SECONDARY_MODEL=
# TOOLS_IMAGE_SECONDARY_MODEL=
# TOOLS_VIDEO_MAX_PROMPT_CHARS=2000
# OPENCONNECTOR_URL=
# OPENCONNECTOR_PUBLIC_ORIGIN=
# OOMOL_CONNECT_ORIGIN=
# OPENCONNECTOR_ADMIN_TOKEN=
# OPENCONNECTOR_ENCRYPTION_KEY=
# OPENCONNECTOR_MCP_URL=
# OPENCONNECTOR_MCP_ID=
# OPENCONNECTOR_MCP_TRANSPORT=sse
# OPENCONNECTOR_MCP_BEARER=
# WORKFLOW_SMTP_HOST=
# WORKFLOW_SMTP_PORT=587
# WORKFLOW_SMTP_USER=
# WORKFLOW_SMTP_PASS=
# WORKFLOW_SMTP_FROM=
# WORKFLOW_TEST_EMAIL_TO=
# WORKFLOW_CERTIFY_USE_LLM_CHECKER=0
# SEED_CONTENT_MEDIA_OWNER=
# MARKET_DATA_PROVIDER=
# MARKET_DATA_BASE_URL=
# MARKET_DATA_API_KEY=
