# WORKFLOW_SMTP_PORT=587
# WORKFLOW_SMTP_SECURE=0
# WORKFLOW_SMTP_USER=
# WORKFLOW_SMTP_PASS=
# WORKFLOW_SMTP_FROM=agent-os@example.com
# WORKFLOW_TEST_EMAIL_TO=you@example.com
# MFA_MODE=TOTP
# AGENT_OS_REQUIRE_MFA=1
# AGENT_OS_DISABLE_MFA=1

# ---- Market data (FMP) — monthly trading screener / regime / history ----
# Required for non-synthetic W1 regime/screener (HTTP 402 without a paid FMP key → paper fallback).
# MARKET_DATA_API_KEY=
# MARKET_DATA_PROVIDER=fmp
# MARKET_DATA_BASE_URL=https://financialmodelingprep.com/stable
# MARKET_DATA_SCREENER_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META
# Optional cache TTLs (seconds) — see knowledgebase/IBKR-MONTHLY-MAKER-TOOLS.md
# MARKET_DATA_CACHE_SCREENER_TTL_SEC_PAPER=21600
# MARKET_DATA_CACHE_SCREENER_TTL_SEC_LIVE=43200
# MARKET_DATA_CACHE_FUNDAMENTALS_TTL_SEC_PAPER=604800
# MARKET_DATA_CACHE_FUNDAMENTALS_TTL_SEC_LIVE=259200
# MARKET_DATA_CACHE_TODAY_BAR_TTL_SEC_PAPER=3600
# MARKET_DATA_CACHE_TODAY_BAR_TTL_SEC_LIVE=900
# MONTHLY_DRAWDOWN_STOP_PCT=4
# IBKR_IS_PAPER=true
# --- Laptop-first architecture (recommended) ---
# Paper Gateway + local-ibkr-bridge on CEO laptop:
#   WEBHOOK_URL=${AGENT_OS_PUBLIC_URL}/api/ibkr-trading/local-bridge-webhook
#   WEBHOOK_SECRET=<same secret as Monthly Trading W3 event hook>
#   LOCAL_BRIDGE_TOKEN / W2 var local_bridge_token must match
# Optional owner IP whitelist for local-bridge-webhook (Settings → IP Whitelists → IBKR bridge).
# Empty list = any IP + secret OK. Non-empty = client IP/CIDR must match (needs real client IP via nginx).
# See knowledgebase/platform-help/33-ip-whitelists.md and deploy/docker-compose.vps-client-ip.yml.
# VPS does not need IBKR_HOST/PORT for W1/W2 when snapshots arrive via webhook.
# Optional VPS co-located Gateway only for force_live / include_live experiments:
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_TRADING_ENABLED=0
# CEO UI: /ibkr-summary — planned vs executed (order ids from flat or nested W2 execute report).
# Clear: POST /api/ibkr-trading/summary/clear-transactional { "confirm": "CLEAR_IBKR_TRANSACTIONAL" }
# Cash for budget: owner IBKR account snapshot only, then workflow cash_usd as fallback
# (never NetLiquidation / invent cash from daily budget). Optional freshness:
# IBKR_CASH_SNAPSHOT_MAX_AGE_HOURS=24
# Step-by-step setup / run / VPS: knowledgebase/platform-help/20-ibkr-monthly-trading.md
#
# ---- Monthly trading W1 brains (seed: seed-monthly-trading-w1-workflow.js) ----
# Cloud only — no Ollama. Keys live in Management → API Keys vault (not platform .env):
#   Maker:   modelSource=openai, model=gpt-4o,         apiKeyRef=openAI_key
#   Checker: modelSource=deepseek, model=deepseek-chat, apiKeyRef=deepseek_key
# Optional Brave Search MCP on Maker/Checker when extra public-web context helps:
#   mcp-brave-search + vault BRAVE_SEARCH_BYOK (X-Subscription-Token / Bearer)
# Optional model overrides (cloud host names only; local Ollama tags are ignored by seed):
# MONTHLY_TRADING_MAKER_MODEL=gpt-4o
# MONTHLY_TRADING_CHECKER_MODEL=deepseek-chat
# MONTHLY_TRADING_MAKER_KEY_REF=openAI_key
# MONTHLY_TRADING_CHECKER_KEY_REF=deepseek_key
# MONTHLY_TRADING_BRAVE_KEY_REF=BRAVE_SEARCH_BYOK
# After stack: docker compose exec backend node scripts/seed-monthly-trading-workflows.js
# Bridge vendor map: local-ibkr-bridge/vendor/trading-plan-bridge-map.js (W2 execute-day-plan)
# Deploy: SKIP_GIT=1 SERVICES=backend bash deploy/scripts/vps-deploy-latest.sh

# ---- Email inbound webhooks (SendGrid/Mailgun → public HTTPS) ----
# Providers POST to: ${AGENT_OS_PUBLIC_URL}/api/integrations/email-inbound/:definitionId
# EMAIL_INBOUND_WEBHOOK_SECRET=

# ---- OpenConnector (connectors façade + optional MCP) ----
# Real OpenConnector runtime (profile optional-openconnector)
# Runtime API (backend façade): OPENCONNECTOR_URL=http://openconnector:3000
# Public browser origin for OAuth callbacks + admin-gated console (nginx /openconnector/ → backend BFF).
# OPENCONNECTOR_PUBLIC_ORIGIN=https://agent-os.example.com/openconnector
# OOMOL_CONNECT_ORIGIN=https://agent-os.example.com/openconnector
# OPENCONNECTOR_URL=http://openconnector:3000
# OPENCONNECTOR_ADMIN_TOKEN=
# OPENCONNECTOR_ENCRYPTION_KEY=
# OPENCONNECTOR_BOOTSTRAP_RUNTIME_TOKEN=
# Image tag: tip (main) has connection-scoped BYOA OAuth; v1.3.5 / latest release does not honor authorize clientId.
# OPENCONNECTOR_IMAGE_TAG=tip
# Connection-scoped CEO OAuth apps (BYOA): set on openconnector + mirror for backend status.
# Requires OC tip (or newer release that documents OOMOL_CONNECT_ALLOWED_CUSTOM_OAUTH).
# OOMOL_CONNECT_ALLOWED_CUSTOM_OAUTH=*
# OPENCONNECTOR_ALLOWED_CUSTOM_OAUTH=*
# MCP discovery (Brain + MCP Integrations): OPENCONNECTOR_MCP_URL=http://openconnector:3000/mcp
# Mock profile optional-openconnector-mock: OPENCONNECTOR_URL=http://openconnector-mcp-mock:3105
# After stack is up: docker compose exec backend node scripts/seed-openconnector-mcp.js
# OPENCONNECTOR_MCP_URL=http://openconnector:3000/mcp
# OPENCONNECTOR_MCP_ID=mcp-openconnector
# OPENCONNECTOR_MCP_BEARER=
# OPENCONNECTOR_MCP_TRANSPORT=streamable_http
# OPENCONNECTOR_MOCK_TOKEN=

# ---- OpenSearch document RAG (internal Docker network only) ----
# Meta + search indices per user; platform indices for help/README.
# Efficiency View Storage (MB) includes this CEO's OpenSearch store sizes (aos-docs-meta-* + aos-docs-search-*).
# Never publish ports 9200/5601. Admin Dashboards: /opensearch/ (admin cookie BFF).
# Admin UI: /admin/documents-rag. Fresh host: bash scripts/ensure-opensearch-env.sh .env
# Kernel (once): sudo sysctl -w vm.max_map_count=262144  (+ persist in /etc/sysctl.conf)
OPENSEARCH_ENABLED=1
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=
# Local Qwen embeddings (docker compose --profile optional-embeddings; ensure-embeddings-env.sh).
# Not OpenAI — no OPENAI_* key required for vector indexing.
# SKIP_EMBEDDINGS=1 — write embedding env keys only; do not start the embeddings container (BM25-only).
# SKIP_EMBEDDINGS=0
OPENSEARCH_EMBEDDING_BASE_URL=http://embeddings:8080/v1
OPENSEARCH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
OPENSEARCH_EMBEDDING_DIMS=1024
OPENSEARCH_EMBEDDING_API_KEY=local
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
# Set 0 for BM25-only. Set 1 (default) for hybrid BM25+kNN via local Qwen.
# After first enable or model/dim change: Reindex all (Master Data / Admin Documents RAG).
OPENSEARCH_EMBEDDINGS_ENABLED=1

# ---- CEO Onboarding Helper (AgentSystem tools; seeded at backend startup) ----
# Tools: onboarding_save_proposal, onboarding_apply_proposal (owner-scoped).
# UI: /onboarding selective Review. Docs + E2E prompts: knowledgebase/platform-help/27-onboarding-helper.md
# Script: backend/scripts/e2e-onboarding-wf-prompts.mjs  (BASE_URL=$AGENT_OS_PUBLIC_URL)
# Re-seed grants: docker exec … node scripts/seed-onboarding-helper-agent.js

# ---- Docker tool onboarding (Admin → Tools Onboarding) ----
# Mount socket via compose overlay: docker-compose.docker-tools.yml
# Fail-closed: empty DOCKER_TOOLS_REGISTRY_ALLOW refuses all pulls.
DOCKER_TOOLS_ENABLED=0
DOCKER_TOOLS_SOCKET=/var/run/docker.sock
DOCKER_TOOLS_SOCKET_HOST=/var/run/docker.sock
DOCKER_TOOLS_NETWORK=
# Comma-separated registry path prefixes (examples):
# DOCKER_TOOLS_REGISTRY_ALLOW=docker.io/library,docker.io/ealen,ghcr.io/myorg
DOCKER_TOOLS_REGISTRY_ALLOW=
DOCKER_TOOLS_REGISTRY_DENY=
DOCKER_TOOLS_MAX_MEMORY_MB=512
DOCKER_TOOLS_MAX_CPUS=1
DOCKER_TOOLS_STEPUP_TTL_MS=300000
# Restart AgentSystem after deploying a new Docker tool so the plugin registers it (set 0 to skip)
DOCKER_TOOLS_RESTART_OPENCLAW=1
DOCKER_GID=0

# ---- Docker disk hygiene (vps-deploy-latest.sh → docker-disk-hygiene.sh) ----
# After compose build, prune BuildKit cache older than UNTIL (keeps recent layers for faster rebuilds).
# SKIP_DOCKER_PRUNE=1 to skip. DOCKER_BUILDER_PRUNE_ALL=1 for a full unused-cache wipe.
# SKIP_DOCKER_PRUNE=0
# DOCKER_BUILDER_PRUNE_UNTIL=72h
# DOCKER_BUILDER_PRUNE_ALL=0
# SKIP_DANGLING_IMAGE_PRUNE=0

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# Smoke: docker compose exec -T backend node scripts/test-opensearch-rag-smoke.js

# ---- Filesystem workflow nodes + inbound / Content Explorer paths ----
# Compose default also mounts AgentSystem tenant + media roots (see docker-compose.yml).
# Content Explorer (`/content-explorer`) lists/deletes CEO uploaded + generated media under these roots.
# Retention (`DATA_RETENTION_CRON`) hard-deletes aged inbound + media/generated/<ceo>/ by mtime.
# Prefer compose default: /data/workflow-fs:/root/.AgentSystem/tenants:/root/.AgentSystem/media
WORKFLOW_FS_ROOTS=/data/workflow-fs

# ---- Workflow autonomous certify (Maker / Checker authoring loop) ----
# AgentSystem Workflow Builder face: agent_workflow_certify_start / _status / _resume.
# Deterministic Checker ALWAYS runs. LLM Checker is optional soft grading on top.
#
# WORKFLOW_CERTIFY_USE_LLM_CHECKER — 0/unset = OFF (recommended default; faster, no
#   hallucinated fail-flips). Set to 1 to enable LLM soft Checker (uses secondary
#   model unless WORKFLOW_CERTIFY_CHECKER_MODEL is set). Hard criteria still come
#   from the deterministic Checker.
# WORKFLOW_CERTIFY_USE_LLM_CHECKER=0
#
# WORKFLOW_CERTIFY_MAX_ATTEMPTS — outer Maker/Checker loops (default 5, hard cap 10)
# WORKFLOW_CERTIFY_MAX_ATTEMPTS=5
# WORKFLOW_CERTIFY_MAX_WALL_MS=300000
# WORKFLOW_CERTIFY_TEST_TIMEOUT_MS=45000
#
# Optional model overrides (else platform primary = Maker, secondary = LLM Checker):
# WORKFLOW_CERTIFY_MAKER_MODEL=
# WORKFLOW_CERTIFY_CHECKER_MODEL=
#
# Monthly Positive Return certify (Phase 4) — recommended BYOK models:
# WORKFLOW_CERTIFY_MAKER_MODEL=gpt-4o
# WORKFLOW_CERTIFY_CHECKER_MODEL=deepseek-chat
# Helper: node backend/scripts/certify-monthly-trading-workflows.js --dry-run
# Paper E2E (no live Gateway): node backend/scripts/test-monthly-trading-paper-e2e.js
# W1 reseeds use vault openAI_key + deepseek_key — not Anthropic / not Ollama.

# ---- Compose overlay list (docker compose uses this when set in deploy/.env) ----
# Production VPS required order (later files override earlier). Do not omit
# docker-compose.vps-client-ip.yml: nginx runs host-network and proxies to
# 127.0.0.1:3001 / 127.0.0.1:8080. Missing overlay recreation historically caused
# container-healthy but public login 502.
# Base docker-compose.yml now also publishes those loopback ports as a safety net.
COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml:docker-compose.vps-client-ip.yml:docker-compose.docker-tools.yml
# Add Business Core when running Twenty/ERPNext stacks (or pass -f docker-compose.business-core.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml:docker-compose.vps-client-ip.yml:docker-compose.docker-tools.yml:docker-compose.business-core.yml
# Local laptop without host-network nginx can clear this or use docker-compose.dev.yml.

# ---- Published ports ----
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# ---- Optional profiles ----
MCP_AUTO_EMIT_MS=5000
# WORKFLOW_HOOK_URL=https://agent-os.example.com/api/agent-workflows/hooks/<definitionId>
# WORKFLOW_HOOK_SECRET=
NOVNC_PORT=6080
# Container clock (cron schedules, log timestamps).
TZ=Asia/Singapore
# Timezone used to render dates for users (Kanban cards, task chat, reports) when the user
# has not set Profile → Display timezone. Defaults to TZ when unset.
# PLATFORM_TIMEZONE=Asia/Singapore
# DB still stores UTC (SQLite datetime('now')). Profile display_timezone overrides this for UI only.
ENABLE_VNC=0

# ---- Business Core (optional Twenty CRM + ERPNext; see deploy/business-core/README.md) ----
# Platform CRM/ERP for entitled companies. Prefab Maker/Checker + tools when Profile selects twenty/erpnext.
# Docs: knowledgebase/platform-help/32-business-core-crm-erp.md
#
# Start Twenty stack:
#   bash deploy/scripts/ensure-business-core-env.sh
#   # or: docker compose -f docker-compose.yml -f docker-compose.business-core.yml --profile optional-twenty up -d
# ERPNext is optional and site-init heavy — START_ERPNEXT=1 only when ready.
#
# --- Critical: public browser URL must be a HOST ROOT ---
# Twenty is a SPA with absolute client routes (/sign-in, /settings, …).
# DO NOT use subdirectory embeds such as https://login.example.com/crm-app
# (router navigates to / → your main Flolah SPA; endless load / wrong iframe).
# DO NOT rely on non-443 ports alone (:8443) if the VPS edge drops them (common on Hostinger).
#
# Recommended public CRM host (dedicated subdomain after DNS + cert SAN expand):
#   TWENTY_SERVER_URL=https://crm.example.com
#   TWENTY_EMBED_URL=https://crm.example.com
# Flolah prod: https://crm.flolah.cloud — marketing stays on flolah.cloud + www only.
# DNS: A/CNAME crm → VPS AND A *.crm → VPS (or per-workspace {sub}.crm) for multi-workspace SSO.
# Cert: bash deploy/scripts/vps-expand-crm-cert.sh
# After workspace DNS: bash deploy/scripts/vps-ensure-crm-workspace-dns-cert.sh
# Admin UI / ops: bash deploy/scripts/vps-refresh-tls-certs.sh [all|platform|crm]
#
# Internal API (backend → Twenty GraphQL; Docker network name only):
TWENTY_API_URL=http://twenty-server:3000
# Operator fills after first Twenty workspace admin login (Settings → API keys):
# TWENTY_API_KEY=
# Prefer not to rely on a single shared API key for multi-CEO CRM tool writes.
# With TWENTY_APP_SECRET + TWENTY_SSO_ENABLED, REST tools mint workspace-scoped
# access tokens for each company owner (prevents writing into the bootstrap workspace).
# Public browser + iframe (host root, no path prefix):
TWENTY_SERVER_URL=https://crm.example.com
TWENTY_EMBED_URL=https://crm.example.com
# Optional nginx listen for path-less alternate HTTPS proxy (often blocked by edge):
TWENTY_PUBLIC_HTTPS_PORT=8443
# Host port mapped to twenty-server container 3000 (loopback on VPS):
TWENTY_HOST_PORT=3100
# App secrets for Twenty container (compose business-core profile):
TWENTY_APP_SECRET=change-me-twenty-app-secret-min-32-chars
# CRM true SSO (passwordless LOGIN token) — same APP_SECRET as Twenty container
TWENTY_SSO_ENABLED=1
# Required for multi-workspace SSO: JIT inserts workspaceMember into core.workspace.databaseSchema
# Optional: postgres://twenty:twenty@twenty-db:5432/twenty for JIT user provision
TWENTY_DB_USER=twenty
TWENTY_DB_NAME=twenty
TWENTY_DATABASE_URL=postgres://twenty:twenty@twenty-db:5432/twenty
# Same Redis as twenty-server REDIS_URL — Flolah invalidates member flat-maps after JIT SSO join.
TWENTY_REDIS_URL=redis://twenty-redis:6379
# Bootstrap creator for signUpInNewWorkspace (first Twenty admin). Company CEOs are still
# provisioned as Admin of their own workspace for passwordless SSO (not only this bootstrap user).
# TWENTY_BOOTSTRAP_EMAIL=
# Do not set a shared TWENTY_WORKSPACE_ID — each CEO binds its own UUID+subdomain via ensureCompanyTwentyWorkspace.
# TWENTY_WORKSPACE_ID=
TWENTY_IS_MULTIWORKSPACE_ENABLED=true
# Optional alias read by backend (twenty-public.js) when TWENTY_* is unset.
# Compose maps TWENTY_IS_MULTIWORKSPACE_ENABLED → container IS_MULTIWORKSPACE_ENABLED.
# IS_MULTIWORKSPACE_ENABLED=true
# Multi-workspace: front resolves API from window.location (required for {sub}.crm.* hosts).
TWENTY_FRONT_AUTO_BASE_URL=true
TWENTY_DB_PASSWORD=twenty
# Optional image pin:
# TWENTY_SERVER_IMAGE=twentycrm/twenty:latest
# TWENTY_SIGN_IN_PREFILLED=false
#
# --- ERPNext (optional; not started by default) ---
# ERPNEXT_URL=http://erpnext-frontend:8080
# (Do not use erpnext-backend:8000 for Agent OS — Node cannot set Host; site resolves as hostname → 404)
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_SSO_ENABLED=1
# ERPNEXT_SITE_NAME=
# ERPNEXT_DEFAULT_COUNTRY=United States
# ERPNEXT_DEFAULT_CURRENCY=USD
# Multi-tenant isolation (shared multi-company site — 1 CEO = 1 Company):
# Custom field flolah_company on Customer/Supplier/Lead/Contact/Address/Item/Item Price/Opportunity
# ERPNEXT_STRICT_USER_PERMISSIONS=1   # desk: empty Link company does not match UP (default on in backend)
# ERPNEXT_TENANT_BACKFILL=1           # stamp existing masters on company ensure (default on)
ERPNEXT_DB_ROOT_PASSWORD=admin
ERPNEXT_HOST_PORT=8085
ERPNEXT_PUBLIC_HTTPS_PORT=8444
# Public browser / iframe — prefer :443 (erp.crm.* reuses CRM DNS wildcard). Avoid :8444 on Hostinger.
# ERPNEXT_EMBED_URL=https://erp.crm.example.com
# ERPNEXT_PUBLIC_URL=https://erp.crm.example.com
# Optional apex once DNS+SAN exist: https://erp.example.com
#
# ensure-business-core-env.sh also sets empty defaults for the keys above; it migrates
# legacy TWENTY_* /crm-app and :8443 embed values to https://crm.<apex>.
#
# MCP server (same process lists CRM+ERP tools; owner scope via X-Ceo-User-Id):
# BUSINESS_CORE_MCP_URL=http://business-core-mcp:8082/mcp
# (Also documented under the Business Core MCP block near META_GRAPH_MCP_URL.)

# AgentSystem session visibility (init → AgentSystem.json)
# OPENCLAW_SESSION_VISIBILITY=agent

# This Week Digest: minutes/task proxy + Est. Value = sum(task hours x agent hourly_rate_usd). Default hire rate 10 USD/hr. THIS_WEEK_VALUE_USD_PER_HOUR is fallback for unassigned/workflows. Insights separate.
THIS_WEEK_MINUTES_PER_TASK=45
THIS_WEEK_VALUE_USD_PER_HOUR=10
# Fallback USD/hr for unassigned tasks + workflow runs when valuing Digest. Per-agent rate is agents.hourly_rate_usd (hire default 10).

# Workspace Builder (JSON pages)
# Components bind only to owner-scoped data; REST endpoints allowlisted in workspace-boards.js
# /work open tasks from Kanban (platform+tenant merge via listKanbanTasksForOwner); this env versions Builder board schema only.
WORKSPACE_BUILDER_SCHEMA_VERSION=2
