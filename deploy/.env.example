# Agent OS — production Compose environment
# Copy to .env and fill in secrets before deploy.
# Keys are injected at container runtime — not baked into images.
# Init writes OPENCLAW_GATEWAY_TOKEN + TOOLS_API_KEY into openclaw.json (gateway + content-tools plugin).

# ---- Public URL ----
AGENT_OS_PUBLIC_URL=https://agent-os.example.com
VITE_API_URL=/api

# ---- Gateway auth (written to openclaw.json at init) ----
OPENCLAW_GATEWAY_TOKEN=change-me-generate-a-long-random-token

# ---- Content tools: OpenClaw plugin ↔ backend auth (required for COO/MCP/kanban tools) ----
# Must match plugins.entries['agent-os-content-tools'].config.apiKey written at init.
# Generate: node ../scripts/ensure-tools-api-key.js --env-file .env --skip-openclaw
TOOLS_API_KEY=change-me-generate-a-long-random-secret

# Backend tool self-dispatch (POST /api/tools/invoke → tool endpoint).
# Must be loopback inside the backend container — public HTTPS (self-signed / hairpin) fails as "fetch failed".
TOOLS_BASE_URL=http://127.0.0.1:3001

# ---- Internal service auth (workflow runner, tools proxy, cron-callback) ----
# Required in production — must be stable across container restarts (not ephemeral).
# Auto-generated by ./scripts/up.sh if empty. Or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_OS_INTERNAL_TOKEN=

# ---- Platform admin ----
AGENT_OS_ADMIN_EMAIL=admin@agent-os.local
AGENT_OS_ADMIN_PASSWORD=change-me-admin-password

# ---- OpenClaw gateway + backend: OpenAI (primary) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Aliases (optional — used if OPENAI_API_KEY / OPENAI_BASE_URL not set)
# OPENAI_PRIMARY_API_KEY=
# OPENAI_PRIMARY_BASE_URL=https://api.openai.com/v1
# OPENAI_PRIMARY_MODEL=gpt-4o-mini

# OpenClaw default agent model slug (written to openclaw.json at init)
OPENCLAW_MODEL_PRIMARY=openai/gpt-4o-mini

# Ollama as OpenClaw silent fallback (default off — tool calling is unreliable on small local models)
# Set to 1 only for experiments; configure-openclaw-docker.js clears fallbacks when unset/0
OPENCLAW_ENABLE_OLLAMA_FALLBACK=0

# ---- Anthropic (OpenClaw gateway — e.g. anthropic/claude-opus-4-6) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ---- Secondary OpenAI-compatible endpoint (optional; backend LLM fallback) ----
# OPENAI_SECONDARY_BASE_URL=https://api.deepseek.com/v1
# OPENAI_SECONDARY_API_KEY=
# OPENAI_SECONDARY_MODEL=deepseek-chat
# Or another OpenAI-compatible host:
# OPENAI_SECONDARY_BASE_URL=https://api.openai.com/v1
# OPENAI_SECONDARY_API_KEY=
# OPENAI_SECONDARY_MODEL=gpt-4o

# ---- Ollama fallback (OpenClaw + optional-ollama profile) ----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=ollama-local
OPENCLAW_OLLAMA_FALLBACK_MODEL=llama3.2

# ---- OpenRouter (backend dev/scripts; Brain nodes use per-node keys in workflow editor) ----
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_SITE_TITLE=Agent OS

# ---- Backend LLM overrides ----
# OPENAI_COO_MODEL=gpt-4o-mini
# OPENAI_INTENT_MODEL=
# TOOLS_SUMMARIZE_MODEL=

# ---- Content tools: image (OpenAI-compatible / GPT-image) ----
# Primary reuses OPENAI_PRIMARY_* / OPENAI_API_KEY above.
TOOLS_IMAGE_MODEL=gpt-image-1
TOOLS_IMAGE_SIZE=1024x1024
TOOLS_IMAGE_QUALITY=medium
TOOLS_IMAGE_STYLE=natural
TOOLS_IMAGE_MAX_PROMPT_CHARS=1000
# TOOLS_IMAGE_SECONDARY_MODEL=gpt-image-1-mini

# ---- Content tools: Replicate video ----
REPLICATE_API_TOKEN=
REPLICATE_PRIMARY_BASE_URL=https://api.replicate.com/v1
# TOOLS_VIDEO_MODEL_VERSION=owner/model:version_id
# TOOLS_VIDEO_MAX_PROMPT_CHARS=500
# REPLICATE_SECONDARY_API_TOKEN=
# TOOLS_VIDEO_SECONDARY_MODEL_VERSION=

# ---- Job Applicant / browser timeouts (ms) ----
OPENCLAW_DISCOVERY_TIMEOUT_MS=900000
OPENCLAW_FETCH_TIMEOUT_MS=240000
# JOB_PIPELINE_CRON_SCHEDULE=0 * * * *

# ---- Custom workflow scripts (Python/JS sandbox in backend container) ----
# CUSTOM_SCRIPT_MAX_BYTES=131072
# CUSTOM_SCRIPT_TIMEOUT_MS=60000
# CUSTOM_SCRIPT_PYTHON=python3
# CUSTOM_SCRIPT_NODE=node
# LLM security review at registration (uses OPENAI_* / Ollama above — same as backend LLM)
# CUSTOM_SCRIPT_LLM_REVIEW=1
# CUSTOM_SCRIPT_LLM_REVIEW_REQUIRED=1
# CUSTOM_SCRIPT_LLM_REVIEW_MAX_TOKENS=768

# ---- Workflow email + MFA OTP + email_send content tool (optional) ----
# Used by: workflow Send Email node, email_send tool (incl. ICS calendar invites), MFA OTP
# notify_ceo (in-app CEO push / NotificationBell) needs no SMTP — granted at backend boot
# WORKFLOW_SMTP_HOST=smtp.example.com
# WORKFLOW_SMTP_PORT=587
# WORKFLOW_SMTP_SECURE=0
# WORKFLOW_SMTP_USER=
# WORKFLOW_SMTP_PASS=
# WORKFLOW_SMTP_FROM=agent-os@example.com
# MFA_MODE=EMAIL
# AGENT_OS_REQUIRE_MFA=0
# AGENT_OS_DISABLE_MFA=1

# ---- Email inbound webhooks (SendGrid/Mailgun → public HTTPS) ----
# Providers POST to: ${AGENT_OS_PUBLIC_URL}/api/integrations/email-inbound/:definitionId
# EMAIL_INBOUND_WEBHOOK_SECRET=

# ---- OpenConnector MCP (SaaS actions via MCP) ----
# Real OpenConnector: OPENCONNECTOR_MCP_URL=http://openconnector:3000/mcp
# Mock (profile optional-openconnector): OPENCONNECTOR_MCP_URL=http://openconnector-mcp-mock:3105/mcp
# After stack is up: docker compose exec backend node scripts/seed-openconnector-mcp.js
# OPENCONNECTOR_MCP_URL=
# OPENCONNECTOR_MCP_ID=mcp-openconnector
# OPENCONNECTOR_MCP_BEARER=
# OPENCONNECTOR_MCP_TRANSPORT=streamable_http
# OPENCONNECTOR_MOCK_TOKEN=

# ---- Filesystem workflow nodes (persisted volume workflow_fs) ----
WORKFLOW_FS_ROOTS=/data/workflow-fs

# ---- Published ports ----
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# ---- Optional profiles ----
MCP_AUTO_EMIT_MS=5000
# WORKFLOW_HOOK_URL=https://agent-os.example.com/api/agent-workflows/hooks/<definitionId>
# WORKFLOW_HOOK_SECRET=
NOVNC_PORT=6080
TZ=Asia/Singapore
ENABLE_VNC=0

# OpenClaw session visibility (init → openclaw.json)
# OPENCLAW_SESSION_VISIBILITY=agent
