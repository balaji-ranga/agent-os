# Local IBKR HTTP bridge - copy to .env (never commit secrets).
# Also loads ../.env (backend) so IBKR_* can live in one place.

# --- Bridge listen (loopback only by default) ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3010
# NODE_ENV=production requires a non-empty LOCAL_BRIDGE_TOKEN
LOCAL_BRIDGE_TOKEN=
# Allow one-time ephemeral token when LOCAL_BRIDGE_TOKEN is empty (dev/smoke only)
BRIDGE_ALLOW_EPHEMERAL_TOKEN=0
# Skip real Gateway; return fixtures (tests / offline smoke)
BRIDGE_MOCK_IBKR=0

# --- VPS (laptop bridge posts fill / order_status / equity / account_snapshot here) ---
# Preferred durable ingest (same secret as Monthly Trading W3 event hook).
# 5-min snapshots/fills save cache; W3 workflow starts on eod_snapshot only (or fanout_w3=1).
#   https://login.<your-domain>/api/ibkr-trading/local-bridge-webhook
# Also used for open-order + cash book on IBKR Summary (not Gateway on VPS).
# Setup: knowledgebase/platform-help/20-ibkr-monthly-trading.md (prereqs + run/monitor)
WEBHOOK_URL=
WEBHOOK_SECRET=
# Match W2 workflow Variable local_bridge_token to LOCAL_BRIDGE_TOKEN above.
# Alternate: full W3 graph on every POST (slower; not the Connectors default):
# WEBHOOK_URL=https://login.flolah.cloud/api/agent-workflows/hooks/monthly-trading-w3-events
WEBHOOK_RETRY_FILE=data/webhook-retry.json
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BASE_BACKOFF_MS=1000

# --- Equity marks during market hours (0 = disabled) ---
EQUITY_MARK_INTERVAL_SEC=300

# --- IB Gateway / TWS (reuse from backend/.env when possible) ---
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=18
# IBKR_ACCOUNT_ID=
# IBKR_IS_PAPER=true
# IBKR_TRADING_ENABLED=0
# IBKR_ALLOW_LIVE=0
