{
  "template_key": "erp-maker-checker",
  "name": "ERP: draft → check → post",
  "description": "Optional Maker→Checker protocol for ERPNext drafts and submit gate. Kanban remains source of truth. Chat: run erp maker checker",
  "chat_trigger_phrase": "run erp maker checker",
  "trigger_modes": [
    "manual",
    "chat"
  ],
  "workflow_id_pattern": "erp-mc-{ownerSlug}",
  "kind": "erp",
  "agent_roles": {
    "maker": [
      "ERP Maker A",
      "ERP Maker B"
    ],
    "checker": [
      "ERP Checker"
    ]
  },
  "graph": {
    "nodes": [
      {
        "id": "trigger-1",
        "type": "trigger",
        "position": {
          "x": 40,
          "y": 200
        },
        "data": {
          "label": "Start",
          "triggerModes": [
            "manual",
            "chat"
          ],
          "chatPhrase": "run erp maker checker",
          "scheduleCron": ""
        }
      },
      {
        "id": "maker-1",
        "type": "agent",
        "position": {
          "x": 260,
          "y": 200
        },
        "data": {
          "label": "ERP Maker A (draft)",
          "agentNameRef": "ERP Maker A",
          "prompt": "You are ERP Maker on Flolah. Goal from CEO/COO:\n\n{{input}}\n\nRules:\n1) Company-scoped erp_* only. Create/update DRAFT docs only — never erp_submit_doc / erp_cancel_doc.\n2) When ready for post, kanban_create_task assigned to **ERP Checker** titled [ERP] Submit {doctype} {name} with full context.\n3) Reply with a short summary: objects touched, Kanban task id, next step for Checker.",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "trigger-1",
              "sourceOutputKey": "text"
            }
          ]
        }
      },
      {
        "id": "checker-1",
        "type": "agent",
        "position": {
          "x": 500,
          "y": 200
        },
        "data": {
          "label": "ERP Checker (review)",
          "agentNameRef": "ERP Checker",
          "prompt": "You are ERP Checker. CEO/COO goal / Maker output:\n\n{{input}}\n\nMaker summary:\n{{maker-1.reply}}\n\nRules:\n1) Review with list/get tools. If safe to post: erp_submit_doc / cancel as required; complete related Kanban.\n2) If bad: comment FINDING: on Kanban and reassign to Maker. Do not bulk-draft.\n3) End your reply with ONLY one JSON line:\n{\"decision\":\"approved\"|\"rejected\",\"adjustments\":\"...\",\"notes\":\"...\"}",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "maker-1",
              "sourceOutputKey": "reply"
            }
          ]
        }
      },
      {
        "id": "if-1",
        "type": "if",
        "position": {
          "x": 740,
          "y": 200
        },
        "data": {
          "label": "If approved (pass 1)",
          "taskConfig": {
            "sourceNodeId": "checker-1",
            "sourceOutputKey": "reply",
            "operator": "contains",
            "compareValue": "\"decision\":\"approved\""
          }
        }
      },
      {
        "id": "maker-2",
        "type": "agent",
        "position": {
          "x": 980,
          "y": 380
        },
        "data": {
          "label": "ERP Maker A (fix)",
          "agentNameRef": "ERP Maker A",
          "prompt": "Checker rejected your draft. Goal: {{input}}\n\nChecker output:\n{{checker-1.reply}}\n\nFix FINDINGS with erp draft tools only; update Kanban for ERP Checker. Never submit.\nShort summary of fixes.",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "checker-1",
              "sourceOutputKey": "reply"
            }
          ]
        }
      },
      {
        "id": "checker-2",
        "type": "agent",
        "position": {
          "x": 1220,
          "y": 380
        },
        "data": {
          "label": "ERP Checker (recheck)",
          "agentNameRef": "ERP Checker",
          "prompt": "Second review after Maker fix.\n\nOriginal goal: {{input}}\nMaker fix: {{maker-2.reply}}\n\nPrior Checker: {{checker-1.reply}}\n\nSubmit if ok (erp_submit_doc) or reject again.\nEnd with ONLY JSON:\n{\"decision\":\"approved\"|\"rejected\",\"adjustments\":\"...\",\"notes\":\"...\"}",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "maker-2",
              "sourceOutputKey": "reply"
            }
          ]
        }
      },
      {
        "id": "if-2",
        "type": "if",
        "position": {
          "x": 1460,
          "y": 300
        },
        "data": {
          "label": "If approved (pass 2)",
          "taskConfig": {
            "sourceNodeId": "checker-2",
            "sourceOutputKey": "reply",
            "operator": "contains",
            "compareValue": "\"decision\":\"approved\""
          }
        }
      },
      {
        "id": "notify-ok",
        "type": "content_tool",
        "position": {
          "x": 1220,
          "y": 80
        },
        "data": {
          "label": "Notify CEO (approved)",
          "toolName": "notify_ceo",
          "taskConfig": {
            "toolName": "notify_ceo",
            "bodyJson": "{\"message\": \"Maker/Checker {{input}} completed (approved). See agent chat/Kanban.\", \"title\": \"ERP gate passed\"}"
          },
          "inputBindings": [
            {
              "id": "input",
              "mode": "dynamic",
              "sourceNodeId": "trigger-1",
              "sourceOutputKey": "text"
            }
          ]
        }
      },
      {
        "id": "notify-escalate",
        "type": "content_tool",
        "position": {
          "x": 1700,
          "y": 380
        },
        "data": {
          "label": "Notify CEO (escalated)",
          "toolName": "notify_ceo",
          "taskConfig": {
            "toolName": "notify_ceo",
            "bodyJson": "{\"message\": \"ERP Maker/Checker still rejected after one fix cycle. Review Kanban findings.\", \"title\": \"ERP gate needs CEO\"}"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "trigger-1",
        "target": "maker-1"
      },
      {
        "id": "e2",
        "source": "maker-1",
        "target": "checker-1"
      },
      {
        "id": "e3",
        "source": "checker-1",
        "target": "if-1"
      },
      {
        "id": "e4",
        "source": "if-1",
        "target": "notify-ok",
        "sourceHandle": "true"
      },
      {
        "id": "e5",
        "source": "if-1",
        "target": "maker-2",
        "sourceHandle": "false"
      },
      {
        "id": "e6",
        "source": "maker-2",
        "target": "checker-2"
      },
      {
        "id": "e7",
        "source": "checker-2",
        "target": "if-2"
      },
      {
        "id": "e8",
        "source": "if-2",
        "target": "notify-ok",
        "sourceHandle": "true"
      },
      {
        "id": "e9",
        "source": "if-2",
        "target": "notify-escalate",
        "sourceHandle": "false"
      }
    ]
  }
}
