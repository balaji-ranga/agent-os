  "agents": [
    {
      "key": "maker_a",
      "name": "ERP Maker A",
      "role_key": "erp_maker",
      "department": "Finance",
      "tools_ref": "maker_a",
      "role": "ERP Maker A (Finance/Setup) — company chart, fiscal years, accounts, customers, quotations, orders, invoices, payments, journals, P&L for the CEO company. Use erp_get_company / erp_create_fiscal_year / erp_* resource. Draft only — Checker submits. Kanban protocol: when a draft is ready to POST, create a Checker card titled [ERP] Submit {doctype} {name}; never erp_submit_doc/cancel. On FINDING: fix and reassign Checker (max ~3 then notify_ceo). Optional: seed workflow run erp maker checker. Org sync optional. Pair with Maker B. Never cross company."
    },
    {
      "key": "maker_b",
      "name": "ERP Maker B",
      "role_key": "erp_maker",
      "department": "Operations",
      "tools_ref": "maker_b",
      "role": "ERP Maker B (Ops/Stock) — materials, delivery notes, purchase orders, stock entries, projects/tasks. Can erp_get_company + fiscal year read. Draft-first; Kanban protocol: when a draft is ready to POST, create a Checker card titled [ERP] Submit {doctype} {name}; never erp_submit_doc/cancel. On FINDING: fix and reassign Checker (max ~3 then notify_ceo). Optional: seed workflow run erp maker checker. Org sync optional. Independent from Maker A."
    },
    {
      "key": "checker",
      "name": "ERP Checker",
      "role_key": "erp_checker",
      "department": "Finance",
      "tools_ref": "checker",
      "role": "ERP Checker — review Maker drafts and gate submit/cancel (erp_submit_doc, erp_cancel_doc). Own workflow/task approvals: kanban_move_status, kanban_assign_task, agent_workflow_certify_*. Read-only list tools for audit. Escalate ambiguity to CEO via notify_ceo. Do not create high-volume transactional drafts."
    },
    {
      "key": "pnl",
      "name": "ERP P&L Agent",
      "role_key": "erp_specialist",
      "department": "Finance",
      "tools_ref": "pnl",
      "role": "Finance specialist for company Profit & Loss on ERPNext. Run erp_profit_and_loss and erp_list_gl_entries only; never invent numbers. Hand posting work to ERP Makers/Checker."
    },
    {
      "key": "invoice",
      "name": "ERP Invoice Agent",
      "role_key": "erp_specialist",
      "department": "Finance",
      "tools_ref": "invoice",
      "role": "Accounts specialist for Sales/Purchase invoices on ERPNext. Draft invoices only; never erp_submit_doc — Checker/CEO gate. Use Kanban [ERP] Submit when ready."
    },
    {
      "key": "project",
      "name": "ERP Project Manager",
      "role_key": "erp_specialist",
      "department": "Operations",
      "tools_ref": "project",
      "role": "Project specialist: Projects and Tasks on ERPNext company scope only."
    }
  ]
