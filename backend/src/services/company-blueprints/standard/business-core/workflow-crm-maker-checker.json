{
  "template_key": "crm-maker-checker",
  "name": "CRM: high-risk → check",
  "description": "Optional Maker→Checker for high-risk CRM proposals (Option 1 process gate). Chat: run crm maker checker",
  "chat_trigger_phrase": "run crm maker checker",
  "trigger_modes": [
    "manual",
    "chat"
  ],
  "workflow_id_pattern": "crm-mc-{ownerSlug}",
  "kind": "crm",
  "agent_roles": {
    "maker": [
      "CRM Maker A",
      "CRM Maker B"
    ],
    "checker": [
      "CRM Checker"
    ]
  },
  "graph": {
    "nodes": [
      {
        "id": "trigger-1",
        "type": "trigger",
        "position": {
          "x": 40,
          "y": 200
        },
        "data": {
          "label": "Start",
          "triggerModes": [
            "manual",
            "chat"
          ],
          "chatPhrase": "run crm maker checker",
          "scheduleCron": ""
        }
      },
      {
        "id": "maker-1",
        "type": "agent",
        "position": {
          "x": 260,
          "y": 200
        },
        "data": {
          "label": "CRM Maker A (draft)",
          "agentNameRef": "CRM Maker A",
          "prompt": "You are CRM Maker on Flolah. Goal from CEO/COO:\n\n{{input}}\n\nRules:\n1) Company-scoped crm_* (or ERPNext sales tools if that pack). Low-risk: execute. High-risk (Won large, merge/delete, bulk, ERP handoff): prepare proposal and kanban_create_task for **CRM Checker** titled [CRM] Review …\n2) Do not treat high-risk as done without Checker path.\n3) Reply with summary + any Kanban id.",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "trigger-1",
              "sourceOutputKey": "text"
            }
          ]
        }
      },
      {
        "id": "checker-1",
        "type": "agent",
        "position": {
          "x": 500,
          "y": 200
        },
        "data": {
          "label": "CRM Checker (review)",
          "agentNameRef": "CRM Checker",
          "prompt": "You are CRM Checker. Goal / Maker:\n\n{{input}}\n\nMaker summary:\n{{maker-1.reply}}\n\nReview high-risk CRM proposals (list tools). Approve quality or reject with FINDING on Kanban back to Maker.\nEnd with ONLY one JSON line:\n{\"decision\":\"approved\"|\"rejected\",\"adjustments\":\"...\",\"notes\":\"...\"}",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "maker-1",
              "sourceOutputKey": "reply"
            }
          ]
        }
      },
      {
        "id": "if-1",
        "type": "if",
        "position": {
          "x": 740,
          "y": 200
        },
        "data": {
          "label": "If approved (pass 1)",
          "taskConfig": {
            "sourceNodeId": "checker-1",
            "sourceOutputKey": "reply",
            "operator": "contains",
            "compareValue": "\"decision\":\"approved\""
          }
        }
      },
      {
        "id": "maker-2",
        "type": "agent",
        "position": {
          "x": 980,
          "y": 380
        },
        "data": {
          "label": "CRM Maker A (fix)",
          "agentNameRef": "CRM Maker A",
          "prompt": "Checker rejected your CRM proposal. Goal: {{input}}\n\nChecker:\n{{checker-1.reply}}\n\nRevise; re-open Kanban for CRM Checker if still high-risk. Short summary.",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "checker-1",
              "sourceOutputKey": "reply"
            }
          ]
        }
      },
      {
        "id": "checker-2",
        "type": "agent",
        "position": {
          "x": 1220,
          "y": 380
        },
        "data": {
          "label": "CRM Checker (recheck)",
          "agentNameRef": "CRM Checker",
          "prompt": "Second CRM review after Maker fix.\n\nGoal: {{input}}\nFix: {{maker-2.reply}}\nPrior: {{checker-1.reply}}\n\nEnd with ONLY JSON:\n{\"decision\":\"approved\"|\"rejected\",\"adjustments\":\"...\",\"notes\":\"...\"}",
          "inputBindings": [
            {
              "id": "prompt",
              "mode": "dynamic",
              "sourceNodeId": "maker-2",
              "sourceOutputKey": "reply"
            }
          ]
        }
      },
      {
        "id": "if-2",
        "type": "if",
        "position": {
          "x": 1460,
          "y": 300
        },
        "data": {
          "label": "If approved (pass 2)",
          "taskConfig": {
            "sourceNodeId": "checker-2",
            "sourceOutputKey": "reply",
            "operator": "contains",
            "compareValue": "\"decision\":\"approved\""
          }
        }
      },
      {
        "id": "notify-ok",
        "type": "content_tool",
        "position": {
          "x": 1220,
          "y": 80
        },
        "data": {
          "label": "Notify CEO (approved)",
          "toolName": "notify_ceo",
          "taskConfig": {
            "toolName": "notify_ceo",
            "bodyJson": "{\"message\": \"Maker/Checker {{input}} completed (approved). See agent chat/Kanban.\", \"title\": \"CRM gate passed\"}"
          },
          "inputBindings": [
            {
              "id": "input",
              "mode": "dynamic",
              "sourceNodeId": "trigger-1",
              "sourceOutputKey": "text"
            }
          ]
        }
      },
      {
        "id": "notify-escalate",
        "type": "content_tool",
        "position": {
          "x": 1700,
          "y": 380
        },
        "data": {
          "label": "Notify CEO (escalated)",
          "toolName": "notify_ceo",
          "taskConfig": {
            "toolName": "notify_ceo",
            "bodyJson": "{\"message\": \"CRM Maker/Checker still rejected after one fix cycle. Review Kanban findings.\", \"title\": \"CRM gate needs CEO\"}"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "trigger-1",
        "target": "maker-1"
      },
      {
        "id": "e2",
        "source": "maker-1",
        "target": "checker-1"
      },
      {
        "id": "e3",
        "source": "checker-1",
        "target": "if-1"
      },
      {
        "id": "e4",
        "source": "if-1",
        "target": "notify-ok",
        "sourceHandle": "true"
      },
      {
        "id": "e5",
        "source": "if-1",
        "target": "maker-2",
        "sourceHandle": "false"
      },
      {
        "id": "e6",
        "source": "maker-2",
        "target": "checker-2"
      },
      {
        "id": "e7",
        "source": "checker-2",
        "target": "if-2"
      },
      {
        "id": "e8",
        "source": "if-2",
        "target": "notify-ok",
        "sourceHandle": "true"
      },
      {
        "id": "e9",
        "source": "if-2",
        "target": "notify-escalate",
        "sourceHandle": "false"
      }
    ]
  }
}
