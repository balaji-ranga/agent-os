{
  "id": "standard-prefabs",
  "name": "Standard platform prefabs & workflow templates",
  "description": "Redeploy-safe catalog of lean platform agents, Business Core Maker/Checker packs, and portfolio workflows. Industry packs live in packs/*.json; these are granted on onboard or when Profile CRM/ERP is enabled.",
  "version": 1,
  "source_layout": {
    "industry_blueprints": "backend/src/services/company-blueprints/packs/",
    "standard_prefabs": "backend/src/services/company-blueprints/standard/",
    "openclaw_workspaces": "openclaw-workspace-templates/",
    "platform_help_rag": "knowledgebase/platform-help/"
  },
  "platform_agents": {
    "pack": "platform-agents.json",
    "grant_on": "ceo_create_and_startup",
    "agent_ids": [
      "balserve",
      "workflowbuilder",
      "platformhelp"
    ],
    "workspace_templates": {
      "balserve": "openclaw-workspace-templates/balserve/",
      "workflowbuilder": "openclaw-workspace-templates/workflowbuilder/",
      "platformhelp": "openclaw-workspace-templates/platformhelp/"
    },
    "seed_scripts": [
      "backend/src/db/seed-default-agents.js",
      "backend/scripts/seed-workflow-builder-agent.js",
      "backend/scripts/seed-platform-help-agent.js"
    ]
  },
  "business_core": {
    "enable_triggers": [
      "profile_crm_erp",
      "company_setup_apply"
    ],
    "crm": {
      "providers": [
        "twenty",
        "erpnext"
      ],
      "pack_twenty": "business-core/agents-crm-twenty.json",
      "pack_erpnext": "business-core/agents-crm-erpnext.json",
      "workflow_template": "business-core/workflow-crm-maker-checker.json",
      "workflow_id_pattern": "crm-mc-{ownerSlug}",
      "chat_phrase": "run crm maker checker"
    },
    "erp": {
      "providers": [
        "erpnext"
      ],
      "pack": "business-core/agents-erp-erpnext.json",
      "workflow_template": "business-core/workflow-erp-maker-checker.json",
      "workflow_id_pattern": "erp-mc-{ownerSlug}",
      "chat_phrase": "run erp maker checker"
    },
    "workspace_templates": {
      "crm_maker_a": "openclaw-workspace-templates/crm-maker-a/",
      "crm_maker_b": "openclaw-workspace-templates/crm-maker-b/",
      "crm_checker": "openclaw-workspace-templates/crm-checker/",
      "erp_maker_a": "openclaw-workspace-templates/erp-maker-a/",
      "erp_maker_b": "openclaw-workspace-templates/erp-maker-b/",
      "erp_checker": "openclaw-workspace-templates/erp-checker/",
      "erp_pnl": "openclaw-workspace-templates/erp-pnl/",
      "erp_invoice": "openclaw-workspace-templates/erp-invoice/",
      "erp_project": "openclaw-workspace-templates/erp-project/"
    },
    "template_map": "openclaw-workspace-templates/business-core-template-map.json"
  },
  "trading": {
    "manifest": "trading/ibkr-workflows-manifest.json",
    "readme": "trading/README.md",
    "note": "Golden monthly W1–W5 graphs live in standard/trading/workflow-*.json (W1 risk_per_trade_pct default 5, blank = Maker decides). Refresh with node scripts/export-standard-ibkr-workflows.js. Paper day-plan/poller remain seed-only (deprecated). Deep pack demo_balaji_ranganathan overlays these graphs at Apply."
  },
  "video_content": {
    "pack": "packs/video_content.json",
    "agents": "video-content/agents.json",
    "workflows_manifest": "video-content/workflows-manifest.json",
    "readme": "video-content/README.md",
    "workspace_templates": {
      "video-orchestrator": "openclaw-workspace-templates/video-orchestrator/",
      "video-story": "openclaw-workspace-templates/video-story/",
      "video-scene": "openclaw-workspace-templates/video-scene/",
      "video-prompt": "openclaw-workspace-templates/video-prompt/"
    },
    "note": "Canonical MD under openclaw-workspace-templates/video-*; graphs under standard/video-content/. Fix there and re-seed/refresh — no hotfixes."
  },
  "industry_blueprints": {
    "dir": "packs/",
    "note": "Industry Day 0 org shapes (content_creator, video_content, trading_ops, general_ops, saas, talent, blank). Day 1 workflow graphs come from published deep blueprints or companion standard templates. trading_ops is org-only; IBKR/monthly graphs live in standard/trading/ + seed scripts + deep pack demo_balaji_ranganathan (W1 risk_per_trade_pct). demo_balaji_ranganathan companions video_content so Apply/Operate install the tested Content Orchestrator + W-Reasoning/Media/Assembly graphs."
  }
}
