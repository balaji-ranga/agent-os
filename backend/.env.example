# Agent OS Backend — copy to .env and set values

# Server
PORT=3001
# Platform API access + error logging: off | error | info
#   off   — no platform API logs
#   error — 5xx access lines + unhandled errors only
#   info  — every API request/response (method, path, status, latency, user) + errors
PLATFORM_LOG_LEVEL=info

# ---- Public URL (required for hosted / DNS deployment) ----
# Used for workflow event hooks, cron webhooks, artifact links, and callbacks.
# Set to your public DNS endpoint (HTTPS recommended).
# AGENT_OS_BASE_URL=https://agent-os.example.com
# AGENT_OS_PUBLIC_URL=https://agent-os.example.com
# PUBLIC_URL=https://agent-os.example.com
# Generated media (/api/media/openclaw/...) requires login by default.
# WhatsApp attaches via MEDIA:/abs/path on the shared OpenClaw volume.
# MEDIA_PUBLIC_SIGNED=1
# MEDIA_SIGNING_SECRET=
# Optional A2A secured token TTL (seconds, default 3600):
# A2A_ACCESS_TOKEN_TTL_SEC=3600
# Optional A2A invoke timing (milliseconds):
# A2A_SYNC_TIMEOUT_MS=120000
# A2A_ASYNC_WATCH_TIMEOUT_MS=86400000
# A2A_CALLBACK_TIMEOUT_MS=15000
# Optional summary-cache full-rebuild cadence (days; default 7):
# LEARNINGS_FULL_REBUILD_DAYS=7
# ORDER_LEARNINGS_FULL_REBUILD_DAYS=7
# BRAIN_HISTORY_FULL_REBUILD_DAYS=7

# Frontend (production build): set VITE_API_URL=https://agent-os.example.com/api
# Dev proxy (optional): VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# OpenClaw workspace (required for MD file management)
OPENCLAW_WORKSPACE_PATH=

# OpenClaw gateway (required for chat with agents)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Job Discovery browser runs need longer than default chat (scroll + paginate + detail pages)
# OPENCLAW_DISCOVERY_TIMEOUT_MS=900000
# OPENCLAW_FETCH_TIMEOUT_MS=240000

# Local Browser Worker (Connectors -> Browser Session package)
# Cloud-side job timeouts / offline detection only.
# Laptop .env (in the zip) keeps BROWSER_HEADLESS=0 and BROWSER_USER_DATA_DIR=browser-profile.
# BROWSER_WORKER_OFFLINE_MS=90000
# BROWSER_WORKER_JOB_TIMEOUT_MS=120000
# Full package embeds portable Node (same DESKTOP_NODE_* cache as workflow Download for Windows).
# DESKTOP_PACKAGE_SKIP_NODE_RUNTIME=0


# Platform admin (seeded on first startup if no admin exists)
# In production / AGENT_OS_STRICT_SECRETS=1, defaults are refused.
# AGENT_OS_ADMIN_EMAIL=admin@agent-os.local
# AGENT_OS_ADMIN_PASSWORD=admin-change-me
# AGENT_OS_SESSION_DAYS=14

# Shared secret for workflow runner ↔ backend, tools proxy, cron-callback (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_OS_INTERNAL_TOKEN=

# MFA platform defaults (overridable per user: mfa_policy, mfa_mode on register / profile)
# MFA_MODE=TOTP                     # EMAIL (OTP via SMTP) or TOTP (authenticator) — production: TOTP
# AGENT_OS_REQUIRE_MFA=1            # platform default: require MFA on login
# With MFA_MODE=EMAIL, unset REQUIRE defaults to ON (every login gets email OTP).
# Set AGENT_OS_REQUIRE_MFA=0 to skip MFA for local/dev (users can still set mfa_policy=on).
# User mfa_policy: inherit | on | off — inherit uses AGENT_OS_REQUIRE_MFA
# User mfa_mode: inherit | EMAIL | TOTP — inherit uses MFA_MODE
# AGENT_OS_DISABLE_MFA=1            # hard kill switch for entire platform (ignores user overrides)
# Requires WORKFLOW_SMTP_* when email OTP is active

# Bala CEO — owns existing platform DB (job profiles under ceo_user_id=default)
# AGENT_OS_BALA_CEO_ID=ceo-bala
# AGENT_OS_BALA_EMAIL=bala@agent-os.local
# AGENT_OS_BALA_PASSWORD=bala-change-me
# AGENT_OS_BALA_NAME=Balaji Muthukrishnan
# AGENT_OS_BALA_REGION=Singapore

# Legacy dev CEO id when not using auth headers (prefer JWT after login)
# AGENT_OS_CEO_USER_ID=default

# CEO registration default when db_mode not sent: shared | tenant
# AGENT_OS_CEO_DB_MODE_DEFAULT=tenant

# ---- LLM / OpenAPI-compliant (OpenClaw gateway, COO, Workflow Builder, tools) ----
# OpenClaw reads these when started via: node scripts/start-gateway-with-env.js
# OPENAI_API_KEY is the main key (shared by gateway + backend direct LLM calls).

# Primary endpoint (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Aliases (optional — used if OPENAI_API_KEY / OPENAI_BASE_URL not set)
OPENAI_PRIMARY_API_KEY=
OPENAI_PRIMARY_BASE_URL=https://api.openai.com/v1
OPENAI_PRIMARY_MODEL=gpt-4o-mini
# OpenClaw agent default model (e.g. openai/gpt-4o-mini) — backend LLM uses the model slug after /
# OPENCLAW_MODEL_PRIMARY=openai/gpt-4o-mini

# Secondary endpoint (optional)
# OPENAI_SECONDARY_BASE_URL=https://api.deepseek.com/v1
# OPENAI_SECONDARY_API_KEY=
# OPENAI_SECONDARY_MODEL=deepseek-chat

# Soft fallbacks when a CEO Profile has OpenAI/OpenRouter but llm_model not set yet.
# Prefer Profile model picker (GET /api/auth/llm-catalog). Do not use DeepSeek primary model ids here.
# OPENAI_BYOK_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Brain workflow node: OpenRouter (OpenAI-compatible) ----
# Used when Brain step model source = openrouter and node fields are blank.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers (recommended by OpenRouter)
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_SITE_TITLE=Agent OS

# ---- DeepSeek (Brain modelSource=deepseek) ----
# Cloud V4 (default Brain preset): https://api.deepseek.com/v1 + deepseek-v4-flash + API key on the node.
# Thinking mode / effort are Brain node attributes (DeepSeek + OpenRouter only).
# Local Ollama alternative (no cloud key):
# DEEPSEEK_BASE_URL=http://ollama:11434/v1
# DEEPSEEK_MODEL=deepseek-v3
# Profile BYOK "deepseek" still means local Ollama unless you change these.

# Overrides per use case
# OPENAI_COO_MODEL=
# OPENAI_INTENT_MODEL=
# TOOLS_SUMMARIZE_MODEL=

# ---- Content tools: OpenClaw plugin auth (required for COO/MCP/kanban tools) ----
# Must match plugins.entries['agent-os-content-tools'].config.apiKey in openclaw.json
# TOOLS_API_KEY=generate-a-long-random-secret

# ---- Content tools: summarize-url ----
# Uses LLM primary/secondary above (same endpoint + key + model). Optional override:
# TOOLS_SUMMARIZE_MODEL=
# TOOLS_SUMMARIZE_TIMEOUT_MS=10000
# TOOLS_SUMMARIZE_MAX_BYTES=512000
# TOOLS_SUMMARIZE_ALLOWED_DOMAINS=

# ---- Content tools: image (OpenAI-compatible / GPT-image) ----
# Primary uses OPENAI_PRIMARY_* above; optional image-specific model. Secondary = separate endpoint/key/model.
# DALL·E 2/3 are retired for many accounts — use gpt-image-1 or gpt-image-1-mini (returns base64; backend saves to /api/media/openclaw/generated/).

# Primary (reuses OPENAI_PRIMARY_BASE_URL and OPENAI_PRIMARY_API_KEY if not set below)
# TOOLS_IMAGE_MODEL=gpt-image-1
# TOOLS_IMAGE_SIZE=1024x1024
# TOOLS_IMAGE_QUALITY=medium
# TOOLS_IMAGE_STYLE=natural
# TOOLS_IMAGE_MAX_PROMPT_CHARS=1000

# Secondary image provider (optional)
# OPENAI_SECONDARY_BASE_URL= (same as LLM secondary if same provider)
# OPENAI_SECONDARY_API_KEY=
# TOOLS_IMAGE_SECONDARY_MODEL=dall-e-3

# ---- Content tools: video (Replicate) ----
# Primary and secondary = different Replicate endpoint/token/model.

# Primary (same REPLICATE_API_TOKEN works for Zeroscope and Google Veo on Replicate)
REPLICATE_PRIMARY_BASE_URL=https://api.replicate.com/v1
REPLICATE_API_TOKEN=
# Zeroscope (default) or Google Veo — get version from Replicate portal (e.g. google/veo-2, google/veo-3-fast)
TOOLS_VIDEO_MODEL_VERSION=anotherjesse/zeroscope-v2-xl:version_id
# REPLICATE_BASE_URL= (alias for REPLICATE_PRIMARY_BASE_URL)
# TOOLS_VIDEO_MAX_PROMPT_CHARS=500

# Secondary (optional)
# REPLICATE_SECONDARY_BASE_URL=https://api.replicate.com/v1
# REPLICATE_SECONDARY_API_TOKEN=
# TOOLS_VIDEO_SECONDARY_MODEL_VERSION=owner/model:version_id

# ---- Content tools: Brave Search (brave_web_search) ----
# Platform default Profile → BRAVE_API_KEY. Any other Profile → vault BRAVE_SEARCH_BYOK only.
# Get a key: https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=
# Optional: platform MCP seed URL (Docker DNS default when unset)
# BRAVE_MCP_URL=http://brave-search-mcp:8080/mcp

# ---- Facebook / Meta Graph MCP OAuth (Connectors → MCPs) ----
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# META_GRAPH_MCP_URL=http://meta-graph-mcp:8081/mcp
# MCP_OAUTH_CALLBACK_URL=https://agent-os.example.com/api/integrations/mcp/oauth/callback
# Seed: node scripts/seed-meta-graph-mcp.js

# ---- Job Applicant workflow (optional) ----
# CEO user id for multi-profile job search (matches dashboard chat user_id)
# AGENT_OS_CEO_USER_ID=default
# Phase 1+: Google Sheets / Drive sync
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# JOB_APPLICANT_SHEET_ID=
# JOB_APPLICANT_GDRIVE_ROOT_FOLDER_ID=
# Setup: node scripts/setup-job-applicant-agents.js
# Pipeline cron — checks each active profile's workflow_schedule (hourly/daily/weekly)
# Use at least hourly for hourly profiles: 0 * * * * (see cron block below)

# ---- Scheduled jobs (crons) — platform-level timers, per-user effect ----
# Every value has a built-in default; all keys are OPTIONAL and shown commented for reference.
# One timer runs per backend process; each tick loops over enabled CEOs / their own rows, so
# per-user settings (standup scheduled_at, workflow schedule_cron, data_retention_days) still apply.
# Full reference: knowledgebase/platform-help/19-scheduled-jobs-and-crons.md
#
# STANDUP_SCHEDULE_CRON=* * * * *          # dispatcher: runs each user standup at its own scheduled_at
# STANDUP_CRON_SCHEDULE=                   # legacy auto-collect standup for every CEO (empty = disabled)
# DELEGATION_CRON_SCHEDULE=* * * * *       # process pending COO -> agent delegation tasks, per CEO
# DELEGATION_STATUS_ONLY_MAX_RETRIES=1      # auto-requeue when agent only posts "marked completed" (0–3)
# AGENT_WORKFLOW_SCHEDULER_CRON=* * * * *  # master tick: runs user workflows whose schedule_cron is due
# JOB_PIPELINE_CRON_SCHEDULE=0 * * * *     # Job Applicant pipeline tick across active job profiles
# COO_STATUS_CHECKER_CRON=0 9 * * *        # daily CEO status report -> standup chat + HTML email
# DATA_RETENTION_CRON=15 3 * * *           # daily purge using each user's Profile data_retention_days
# KANBAN_ORPHAN_WATCHER_CRON=*/5 * * * *   # re-pend stuck processing + reinitiate orphan specialty Kanban
# SCHEDULED_GOALS_CRON=* * * * *          # CEO scheduled goals: hourly|daily|weekdays|weekly prompts → AI employee
#
# Cron expressions follow the container clock (TZ). Dates rendered for users (Kanban cards and task
# chat, status reports) use PLATFORM_TIMEZONE when set, else TZ, else the process zone.
# TZ=Asia/Singapore
# PLATFORM_TIMEZONE=Asia/Singapore

# ---- Agent Workflows (custom n8n-style, separate from job workflows) ----
# Workflow Builder agent chat uses OPENAI_API_KEY / OPENAI_BASE_URL from above (same as OpenClaw).
# Brain workflow nodes do NOT use platform .env API keys — configure apiKey on each Brain node in the editor.
# SMTP for Send Email workflow task / email_send tool (or configure per-node in editor)
# Sender must be verified with your provider (Flowlah: admin@flolah.com via Brevo).
# WORKFLOW_SMTP_HOST=smtp-relay.brevo.com
# WORKFLOW_SMTP_PORT=587
# WORKFLOW_SMTP_SECURE=0
# WORKFLOW_SMTP_USER=
# WORKFLOW_SMTP_PASS=
# WORKFLOW_SMTP_FROM=admin@flolah.com
# Test: node scripts/test-email-send-tool.js
# WORKFLOW_TEST_EMAIL_TO=you@example.com

# ---- IBKR Gateway connection (infrastructure only) ----
# Trading policy (allowlist, budget, stops, hold days) lives on the workflow Variables panel — not here.
# Laptop-first setup: knowledgebase/platform-help/20-ibkr-monthly-trading.md
# See knowledgebase/IBKR-TRADING-WORKFLOW.md
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=17
# IBKR_ACCOUNT_ID=
# IBKR_IS_PAPER=true
# IBKR_TRADING_ENABLED=0
# IBKR_ALLOW_LIVE=0
# Auto-resubmit once with advancedErrorOverride when IBKR Lite rejects commission-free (1=on)
# IBKR_AUTO_RETRY_COMMISSION=1
# Laptop local-ibkr-bridge (see backend/local-ibkr-bridge/.env.example):
# LOCAL_BRIDGE_TOKEN=
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=3010
# WEBHOOK_URL=${AGENT_OS_PUBLIC_URL}/api/ibkr-trading/local-bridge-webhook
# WEBHOOK_SECRET=

# Seed workflows: node scripts/seed-ibkr-maker-checker-workflow.js
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_CONTEXT_WINDOW=32768

# ---- Market data (FMP) — monthly trading screener / regime / history ----
# MARKET_DATA_API_KEY=
# MARKET_DATA_PROVIDER=fmp
# Use FMP stable API (legacy /api/v3 is blocked for new keys):
# MARKET_DATA_BASE_URL=https://financialmodelingprep.com/stable
# Free-tier screener fallback universe (comma-separated) when company-screener returns 402:
# MARKET_DATA_SCREENER_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META
# Optional cache TTLs (seconds) — see knowledgebase/IBKR-MONTHLY-MAKER-TOOLS.md
# MARKET_DATA_CACHE_SCREENER_TTL_SEC_PAPER=21600
# MARKET_DATA_CACHE_SCREENER_TTL_SEC_LIVE=43200
# MARKET_DATA_CACHE_FUNDAMENTALS_TTL_SEC_PAPER=604800
# MARKET_DATA_CACHE_FUNDAMENTALS_TTL_SEC_LIVE=259200
# MARKET_DATA_CACHE_TODAY_BAR_TTL_SEC_PAPER=3600
# MARKET_DATA_CACHE_TODAY_BAR_TTL_SEC_LIVE=900
# MONTHLY_DRAWDOWN_STOP_PCT=4

# ---- Custom scripts (LangGraph / Python / JS sandbox) ----
# Scripts run in isolated subprocess with static security scan on upload.
# CUSTOM_SCRIPT_MAX_BYTES=131072
# CUSTOM_SCRIPT_TIMEOUT_MS=60000
# CUSTOM_SCRIPT_PYTHON=python
# CUSTOM_SCRIPT_NODE=node
# LLM security review (second layer after regex scan; uses OPENAI_* / Ollama from backend .env)
# CUSTOM_SCRIPT_LLM_REVIEW=1
# CUSTOM_SCRIPT_LLM_REVIEW_REQUIRED=1
# CUSTOM_SCRIPT_LLM_REVIEW_MAX_TOKENS=768
# Test: node scripts/test-custom-scripts.js

# ---- OpenConnector (MCP gateway for SaaS actions) ----
# Run mock for local/e2e: node tools/openconnector-mcp-mock/server.js
# Or point at real OpenConnector Docker: http://localhost:3000/mcp
# OPENCONNECTOR_MCP_URL=http://127.0.0.1:3105/mcp
# OPENCONNECTOR_MCP_ID=mcp-openconnector
# OPENCONNECTOR_MCP_BEARER=
# OPENCONNECTOR_MCP_TRANSPORT=streamable_http
# OPENCONNECTOR_MOCK_PORT=3105
# OPENCONNECTOR_MOCK_TOKEN=
# Seed: node scripts/seed-openconnector-mcp.js

# ---- Email inbound (webhook from SendGrid/Mailgun/etc. — not IMAP) ----
# EMAIL_INBOUND_WEBHOOK_SECRET=   # optional platform secret; workflow hook secret also works
# POST /api/integrations/email-inbound/:definitionId

# ---- Filesystem workflow node (schedule a workflow to poll folders) ----
# Comma-separated absolute roots; if unset, uses <cwd>/tmp/workflow-fs
# WORKFLOW_FS_ROOTS=C:/data/inbox,C:/data/processed
# E2E: node scripts/test-openconnector-webhooks-e2e.js

# ---- Workflow autonomous certify (Maker / Checker authoring loop) ----
# OpenClaw Workflow Builder: agent_workflow_certify_start / _status / _resume.
# Deterministic Checker ALWAYS runs. LLM Checker is optional soft grading on top.
#
# WORKFLOW_CERTIFY_USE_LLM_CHECKER — 0/unset = OFF (recommended). 1 = enable LLM soft
#   Checker (secondary model unless WORKFLOW_CERTIFY_CHECKER_MODEL is set). Hard
#   criteria (run completed / preflight / structural) stay deterministic.
# WORKFLOW_CERTIFY_USE_LLM_CHECKER=0
#
# WORKFLOW_CERTIFY_MAX_ATTEMPTS — outer Maker/Checker loops (default 5, hard cap 10)
# WORKFLOW_CERTIFY_MAX_ATTEMPTS=5
# WORKFLOW_CERTIFY_MAX_WALL_MS=300000
# WORKFLOW_CERTIFY_TEST_TIMEOUT_MS=45000
#
# Optional model overrides (else platform primary = Maker, secondary = LLM Checker):
# WORKFLOW_CERTIFY_MAKER_MODEL=
# WORKFLOW_CERTIFY_CHECKER_MODEL=
#
# Monthly Positive Return certify (Phase 4) — recommended BYOK models:
# WORKFLOW_CERTIFY_MAKER_MODEL=claude-opus-4-20250514
# WORKFLOW_CERTIFY_CHECKER_MODEL=deepseek-v4-flash
# Helper: node backend/scripts/certify-monthly-trading-workflows.js --dry-run
# Paper E2E (no live Opus/Gateway): node backend/scripts/test-monthly-trading-paper-e2e.js
